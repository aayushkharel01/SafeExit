rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'ADMIN'; }
    function sameOrg(org) { return signedIn() && me().organizationId == org; }

    match /organizationCodes/{code} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if false;
    }
    match /organizations/{organizationId} {
      allow read: if sameOrg(organizationId);
      allow update: if isAdmin() && sameOrg(organizationId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeEmergencyId']);
      allow create: if false;
    }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'STUDENT';
      allow read: if signedIn() && (request.auth.uid == userId || (isAdmin() && sameOrg(resource.data.organizationId)));
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if false;
    }
    match /emergencies/{emergencyId} {
      allow read: if signedIn() && sameOrg(resource.data.organizationId) && (resource.data.active == true || isAdmin());
      allow create: if isAdmin() && sameOrg(request.resource.data.organizationId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && sameOrg(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if false;
      match /acknowledgements/{studentUid} {
        allow read: if isAdmin() && sameOrg(get(/databases/$(database)/documents/emergencies/$(emergencyId)).data.organizationId);
        allow create, update: if signedIn() && request.auth.uid == studentUid && sameOrg(get(/databases/$(database)/documents/emergencies/$(emergencyId)).data.organizationId) && request.resource.data.studentUid == studentUid;
        allow delete: if false;
      }
    }
  }
}
